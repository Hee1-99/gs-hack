# Gemini API 키는 서버에서만 읽습니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# true: 결정론적 데모 응답, false: Gemini 호출 후 실패 시 데모 응답으로 전환
AI_DEMO_MODE=true

# Optional account/team backend: public publishable key only, never service_role/secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
